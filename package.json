{
  "name": "sistersofbeauty",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "biome format --write .",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "worker": "bun run --cwd apps/api worker",
    "bootstrap:owner": "bun run --cwd apps/api bootstrap:owner",
    "maintenance": "bun run --cwd apps/api maintenance",
    "k6:availability": "k6 run k6/availability.js",
    "k6:contention": "k6 run k6/booking-contention.js && bun k6/check-overlaps.ts",
    "k6:mixed": "k6 run k6/mixed.js",
    "k6:overlaps": "bun k6/check-overlaps.ts",
    "test:scripts": "bun test scripts",
    "backup": "bash scripts/backup.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "turbo": "2.11.11",
    "typescript": "7.0.2"
  }
}
