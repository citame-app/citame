# Example reverse proxy with automatic TLS (Let's Encrypt), used by the `tls` profile of
# compose.prod.yaml. Set SITE_ADDRESS to your public host name (DNS must point at this machine
# and ports 80/443 must be reachable). For a local smoke test over plain http use
# SITE_ADDRESS=:80.
# To receive certificate expiry notices add `email you@salon.example` to the global block below.

# Single-use secrets travel in URLs (`?token=` on verify-email and the reminder opt-out,
# `/reset-password/<token>` in the reset link). Both the access log (site block) and Caddy's own
# default log (which records failed requests, for example an unreachable upstream) redact them.
{
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp "(/reset-password/|[?&]token=)[^/?&#]*" "${1}REDACTED"
			request>headers>Referer regexp "(/reset-password/|[?&]token=)[^/?&#]*" "${1}REDACTED"
		}
	}
}

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# Caddy appends the visitor's address to X-Forwarded-For. The web service (WEB_TRUST_PROXY=true)
	# reads the LAST entry, so the rate limiter and logs see the real client, not Caddy.
	reverse_proxy web:4173 {
		health_uri /healthz
		health_interval 10s
		# Server-sent events (offline sync) must not be buffered.
		flush_interval -1
	}

	# The metrics endpoint is internal: it is never routed publicly (the web service also blocks it).
	@internal path /api/metrics /api/metrics/*
	respond @internal 404

	# Single-use secrets travel in URLs (`?token=` on verify-email and the reminder opt-out,
	# `/reset-password/<token>` in the reset link): keep them out of the access log.
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp "(/reset-password/|[?&]token=)[^/?&#]*" "${1}REDACTED"
			request>headers>Referer regexp "(/reset-password/|[?&]token=)[^/?&#]*" "${1}REDACTED"
		}
	}
}
