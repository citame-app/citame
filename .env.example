# Production template for compose.prod.yaml. Copy to .env and chmod 600 .env.
# Fill every required value before starting the stack; never commit real secrets.
# Local development uses compose.yaml defaults; see README.md for its quickstart.

# Required: generate once with openssl rand -hex 32 (URL-safe database password).
POSTGRES_PASSWORD=
# Required: generate once with openssl rand -base64 32; keep stable across upgrades.
BETTER_AUTH_SECRET=
# Required: public HTTPS origin, without a trailing slash.
PUBLIC_URL=
# Required for verification and account emails; URL-encode SMTP credentials.
# Example format: smtps://user:password@smtp.example:465
SMTP_URL=
NOTIFY_EMAIL_FROM="Sisters of Beauty <no-reply@salon.example>"

# Required when using the tls profile: bare hostname, without https://.
SITE_ADDRESS=
# Enable only when an edge proxy you control sits in front of the web server.
# With the bundled Caddy tls profile, set WEB_TRUST_PROXY=true.
WEB_TRUST_PROXY=false
WEB_PUBLISH=127.0.0.1:4173

# Production defaults: email verification enabled, SMTP, no SMS.
AUTH_REQUIRE_EMAIL_VERIFICATION=true
NOTIFY_EMAIL_PROVIDER=smtp
NOTIFY_SMS_PROVIDER=none
NOTIFY_DEFAULT_LOCALE=en

# Optional: 16+ character bearer token for the Prometheus metrics endpoint.
# METRICS_TOKEN=
# Optional SMS credentials (required together when NOTIFY_SMS_PROVIDER=twilio).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# Supply OWNER_EMAIL / OWNER_PASSWORD only when running bootstrap-owner.
# The salon timezone is configured in Admin > Settings after first sign-in.

# Optional online payments. Disabled until the bank provides merchant credentials.
# Keep test mode until the bank has approved live use. Never use public test keys here.
PAYMENT_PROVIDER=none
REDSYS_ENVIRONMENT=test
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=
REDSYS_SECRET_KEY=
# Enable Bizum only if it has been activated on your bank terminal.
REDSYS_BIZUM_ENABLED=false
